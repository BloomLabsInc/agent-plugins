{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "^(mcp__.*|exec)$",
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"${PLUGIN_ROOT}/bin/bloom-hook\" codex"
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"${PLUGIN_ROOT}/bin/bloom-hook\" codex"
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"${PLUGIN_ROOT}/bin/bloom-hook\" codex"
                    }
                ]
            }
        ]
    }
}
