{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "mcp__.*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"${CLAUDE_PLUGIN_ROOT}/plugin/bin/bloom-hook\" claude-code",
                        "async": true,
                        "timeout": 120
                    }
                ]
            }
        ],
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"${CLAUDE_PLUGIN_ROOT}/plugin/bin/bloom-wait\"",
                        "asyncRewake": true,
                        "rewakeSummary": "Woken by Bloom",
                        "rewakeMessage": "Bloom woke this session (not the user).",
                        "timeout": 86400
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "sh \"${CLAUDE_PLUGIN_ROOT}/plugin/bin/bloom-wait\"",
                        "asyncRewake": true,
                        "rewakeSummary": "Woken by Bloom",
                        "rewakeMessage": "Bloom woke this session (not the user).",
                        "timeout": 86400
                    }
                ]
            }
        ]
    }
}
