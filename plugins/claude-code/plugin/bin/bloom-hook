#!/bin/sh
# Bloom's hook launcher: every hook runs `bloom hook <harness>` from the @bloom/cli release pinned in
# `../cli-version`, with the hook's input on stdin. Two layouts, one file: the Claude Code plugin
# (`plugin/bin/bloom-hook`, pin `plugin/cli-version`), and Codex, where `bloom hooks install codex`
# copies it to `~/.bloom/bin/bloom-hook` (pin `~/.bloom/cli-version`) and names it in
# `~/.codex/hooks.json`. Codex trusts that hook by its command alone, so this file and the pin may
# change with each release without asking the person to Trust again; the pin is the security
# surface, so it must be a plain release (never `latest`, never empty) or nothing runs. npx resolves
# it from ~/.bloom, never from the working directory's project, where a Bloom checkout's own
# packages/cli made a plain npx exit 127 (T-59, #6630). A hook never fails its client's call:
# problems go to ~/.bloom/plugin.log, and it exits 0.
#
# Node starts only when there is something to do: after a tool call whose result carries a Bloom
# watch code, for a Codex thread the plugin already connected, or for a Claude Code re-arm. Any
# other hook call (every other MCP server's result, every prompt of an unconnected thread) ends
# here, in sh.
#
# BLOOM_PLUGIN_DISABLED=1 in the client's environment turns every hook off.
case "${BLOOM_PLUGIN_DISABLED:-}" in 1 | true | TRUE) exit 0 ;; esac
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || exit 0
v=$(tr -d ' \n' <"$here/../cli-version" 2>/dev/null)
# A plain release only (the CLI's CLI_PIN_PATTERN): never a tag npm would resolve, such as `latest`.
if ! printf '%s' "$v" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$'; then
    mkdir -p "$HOME/.bloom" 2>/dev/null &&
        echo "bloom-hook: $here/../cli-version is missing or not a release; reinstall Bloom's hooks" >>"$HOME/.bloom/plugin.log"
    exit 0
fi
in=
case " $* " in
*" --rearm "*) ;;
*)
    in=$(cat)
    # The heartbeat `bloom doctor` reads: this client ran a Bloom hook, when, and for which event.
    ev=$(printf '%s' "$in" | tr -d '\n' | sed -n 's/.*"hook_event_name" *: *"\([A-Za-z]*\)".*/\1/p')
    mkdir -p "$HOME/.bloom/plugin" 2>/dev/null && printf '%s %s\n' "$(date +%s)" "$ev" >"$HOME/.bloom/plugin/$1.last" 2>/dev/null
    case "$in" in
    *'"hook_event_name":"PostToolUse"'* | *'"hook_event_name": "PostToolUse"'*)
        case "$in" in *wc_*) ;; *) exit 0 ;; esac
        ;;
    *)
        # SessionStart or UserPromptSubmit: only a thread the plugin connected has a link.
        sid=$(printf '%s' "$in" | tr -d '\n' | sed -n 's/.*"session_id" *: *"\([^"]*\)".*/\1/p')
        key=$(printf '%s' "$sid" | tr -c 'A-Za-z0-9_-' '_')
        [ -n "$sid" ] && [ -s "$HOME/.bloom/plugin/$1/$key.json" ] || exit 0
        ;;
    esac
    ;;
esac
mkdir -p "$HOME/.bloom" 2>/dev/null || exit 0
out=$(printf '%s' "$in" | npx -y --prefix "$HOME/.bloom" "@bloom/cli@$v" hook "$@" 2>>"$HOME/.bloom/plugin.log")
# The CLI's one stdout line for the client (Codex's PostToolUse `hookSpecificOutput`, telling the
# agent something it must know) goes back to the client; anything else on stdout goes to the log.
printf '%s\n' "$out" | grep '^{"hookSpecificOutput"' | head -n 1
printf '%s\n' "$out" | grep -v -e '^{"hookSpecificOutput"' -e '^$' >>"$HOME/.bloom/plugin.log"
exit 0
